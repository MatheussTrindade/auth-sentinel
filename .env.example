# ─────────────────────────────────────────────────────────────
# Auth Sentinel — exemplo de configuração.
# Copie para .env e preencha com seus valores. NUNCA versione o .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Token estático da API da Axur (gerado no painel). OBRIGATÓRIO para --from-axur / --update-axur.
AXUR_API_TOKEN=

# Base da API da Axur (altere só se usar outro gateway/ambiente)
AXUR_API_BASE=https://api.axur.com/gateway/1.0/api
